# ---- secrets (openssl rand -hex 32) ----
JWT_SECRET=change-me
ADMIN_PASSWORD=change-me

# ---- edge (the Raspberry Pi through Cloudflare Tunnel) ----
# "mock" = fake edge, for running the cloud without hardware.
EDGE_URL=https://edge.example.com
# Must equal EDGE_API_TOKEN in edge/.env on the Pi.
EDGE_API_TOKEN=change-me
# Optional extra lock: Cloudflare Access service token in front of the tunnel.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---- business settings ----
TZ_NAME=Asia/Bangkok
DOOR_RELAY=door
DOOR_UNLOCK_SECONDS=5

# ---- Caddy (docker compose --profile https up -d) ----
PUBLIC_HOST=freshlab.example.com
