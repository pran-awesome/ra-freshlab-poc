{
  "name": "@freshlab/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entry/node.ts",
    "build": "esbuild src/entry/node.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/node.js",
    "start": "node dist/node.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241205.0",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "esbuild": "0.24.0"
  }
}
