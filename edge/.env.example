# ---- edge API ----
# Long random string; the cloud sends it as "Authorization: Bearer <token>".
#   openssl rand -hex 32
EDGE_API_TOKEN=change-me
# name:channel (channels are Nano relay CH0..CH3, see docs/hardware.md)
EDGE_RELAYS=door:0,pump:1,light:2,fan:3
EDGE_POLL_INTERVAL_S=5

# ---- host device of the Nano ----
# CH340 clones show up as /dev/ttyUSB0, genuine boards often too.
# Prefer the stable path from: ls -l /dev/serial/by-id/
NANO_DEVICE=/dev/ttyUSB0

# ---- Cloudflare Tunnel (start with: docker compose --profile tunnel up -d) ----
# Zero Trust dashboard -> Networks -> Tunnels -> Create -> copy token.
# Public hostname: edge.<your-domain>  ->  service http://edge:8080
CLOUDFLARE_TUNNEL_TOKEN=
